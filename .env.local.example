# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored and must never be committed.

# --- Neon Postgres -----------------------------------------------------------
# Use the POOLED Neon endpoint: the hostname must contain "-pooler".
# Keep sslmode=require (and do NOT remove it).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.<region>.aws.neon.tech/clubhouse?sslmode=require"

# --- App ---------------------------------------------------------------------
# Secret used to sign rep session tokens. Use a long random string (32+ chars).
SESSION_SECRET=""
# Shown as the wordmark in the site header.
CLUBHOUSE_NAME="Janapriya LakeFront Clubhouse"

# --- Per-block credentials (one shared login per block) ----------------------
# For each block: C1, C2, D, E.
# _REPS, _PHONES and _EMAILS are comma-separated lists (trimmed, blanks dropped).
# Quote any value that contains "#" (an unquoted # starts a comment and is dropped).

BLOCK_C1_USERNAME=""
BLOCK_C1_PASSWORD=""
BLOCK_C1_CODE=""
BLOCK_C1_REPS=""
BLOCK_C1_PHONES=""
BLOCK_C1_EMAILS=""

BLOCK_C2_USERNAME=""
BLOCK_C2_PASSWORD=""
BLOCK_C2_CODE=""
BLOCK_C2_REPS=""
BLOCK_C2_PHONES=""
BLOCK_C2_EMAILS=""

BLOCK_D_USERNAME=""
BLOCK_D_PASSWORD=""
BLOCK_D_CODE=""
BLOCK_D_REPS=""
BLOCK_D_PHONES=""
BLOCK_D_EMAILS=""

BLOCK_E_USERNAME=""
BLOCK_E_PASSWORD=""
BLOCK_E_CODE=""
BLOCK_E_REPS=""
BLOCK_E_PHONES=""
BLOCK_E_EMAILS=""
